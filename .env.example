# Core
APP_BASE_URL=https://example.com
PURCHASES_ENABLED=false
PIX_ENABLED=false
PIX_MIN_DEPOSIT_CENTS=500
PIX_MAX_DEPOSIT_CENTS=100000
ADMIN_API_TOKEN=replace-me
CRON_SECRET=replace-me

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional override. If empty, APP_BASE_URL + /miniapp is used.
TELEGRAM_MINI_APP_URL=

# Supabase (server only; do NOT prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# SMSPool — preferred provider candidate
# Keep the API key server-side only.
SMSPOOL_API_KEY=
# Do not set true until SMSPool has explicitly approved the Central SMS resale/white-label model in writing.
SMSPOOL_COMMERCIAL_APPROVED=false
# Official API examples and cancellation responses are denominated in dollars.
SMSPOOL_PRICE_CURRENCY=USD

# 5SIM — retained as a secondary/legacy candidate
FIVESIM_TOKEN=
# 5SIM API docs expose numeric prices but do not state the currency on the API page.
# Confirm in your account/support before enabling purchases.
FIVESIM_PRICE_CURRENCY=UNCONFIRMED

# Pricing
DEFAULT_MARKUP_PERCENT=30
DEFAULT_MARKUP_FIXED_BRL_CENTS=20
PROVIDER_TO_BRL_RATE=

# Mercado Pago (server-only secrets)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Use only with Mercado Pago test credentials. Forces the documented PIX Orders test scenario.
MERCADO_PAGO_TEST_MODE=false
